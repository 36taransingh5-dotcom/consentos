# ConsentOS web app / API.
#
# Local development needs NONE of these: without DATABASE_URL, ConsentOS runs on
# embedded Postgres (PGlite) in .data/, generates a dev signing key and session
# secret, and uses local test credentials for Pixly and the demo reset.

# --- Storage -----------------------------------------------------------------
# Supabase (or any Postgres) connection string. Setting it switches to
# production mode: the secrets below become mandatory.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# CONSENTOS_AUTO_MIGRATE=false        # true: apply supabase/migrations on boot
# CONSENTOS_DB_POOL_SIZE=5
# CONSENTOS_DATA_DIR=.data            # local mode only
# CONSENTOS_PGLITE_DIR=memory://      # local mode only: ephemeral database

# --- Auth ----------------------------------------------------------------------
# With both set, ConsentOS uses Supabase Auth; otherwise its own email/password auth.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=           # server-only; creates pre-confirmed users
# CONSENTOS_SESSION_SECRET=            # >= 32 chars; signs sessions and extension tokens

# --- Receipts --------------------------------------------------------------------
# Ed25519 private key, PKCS#8 PEM (or base64 of the PEM). See docs/DEPLOYMENT.md.
# CONSENTOS_SIGNING_KEY=
# CONSENTOS_VERIFICATION_KEYS=[]       # JSON array of older public JWKs (rotation)

# --- URLs --------------------------------------------------------------------------
# CONSENTOS_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_PIXLY_URL=http://localhost:3001

# --- Registered services -------------------------------------------------------------
# PIXLY_API_KEY=cos_live_...           # Pixly's secret; stored here only as a SHA-256 hash
# PIXLY_DOMAIN=localhost:3001          # host[:port] the extension verifies Pixly pages against

# --- Demo ---------------------------------------------------------------------------
# CONSENTOS_DEMO_MODE=true             # "false" disables POST /api/demo/reset entirely
# CONSENTOS_DEMO_RESET_TOKEN=
# CONSENTOS_DEMO_PASSWORD=consentos-demo
