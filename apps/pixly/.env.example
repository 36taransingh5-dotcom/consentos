# Pixly — the ConsentOS reference integration.
#
# Local development needs none of these: against http://localhost:3000 Pixly
# uses the local test API key and demo reset token that ConsentOS seeds.

# Where ConsentOS's API lives (server-side calls from Pixly's backend).
# CONSENTOS_API_URL=http://localhost:3000

# Pixly's secret service key. Server-side only; never sent to the browser.
# Must equal PIXLY_API_KEY on the ConsentOS side.
# CONSENTOS_API_KEY=cos_live_...

# The ConsentOS user Pixly's signed-in demo user is linked to.
# PIXLY_CONSENTOS_USER_ID=7e57de30-0000-4000-8000-000000000001

# Lets Pixly's "Reset demo" button reset the linked ConsentOS demo account.
# CONSENTOS_DEMO_RESET_TOKEN=

# Public: where "Protected by ConsentOS" and receipt links point.
# NEXT_PUBLIC_CONSENTOS_WEB_URL=http://localhost:3000
